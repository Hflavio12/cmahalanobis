#' 
#' @export
pvalueschamm <- function(dataset, formula, pvalue.method = "permutation", seed = NULL, min_group_size = 3, num_replicas = 1000, automatic_encoding = FALSE, na_removal = FALSE, grouping_stat = 'median') {
  
