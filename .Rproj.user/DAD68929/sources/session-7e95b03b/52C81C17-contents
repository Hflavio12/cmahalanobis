    } else if (grouping_stat == 'median') {
      
      medians <-  lapply(valid_groups, function(dt_group) {
        num_cols <- dt_group[sapply(dt_group, is.numeric)]
        m <- colMedians(as.matrix(num_cols))
        
        s <- sum2(m, na.rm = TRUE)
